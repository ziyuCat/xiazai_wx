page {
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(22, 196, 95, 0.1) 0%, rgba(22, 196, 95, 0) 34%),
    linear-gradient(180deg, #f6fbf7 0%, #eef6f0 52%, #eaf3ed 100%);
  color: #18221c;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1.2;
  padding: 0;
}

button::after {
  border: none;
}
