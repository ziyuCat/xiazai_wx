.page-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 18rpx;
  background: linear-gradient(180deg, #13bf5b 0%, #0fb254 140rpx, #f4f7f3 140rpx, #f4f7f3 100%);
}

.share-card,
.result-card {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(15, 105, 47, 0.08);
}

.share-card {
  margin-top: 4rpx;
  padding: 18rpx 20rpx;
}

.share-label,
.field-label {
  font-size: 22rpx;
  color: #849085;
}

.field-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1a241f;
  word-break: break-all;
}

.share-textarea {
  width: 100%;
  min-height: 96rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(19, 183, 91, 0.22);
  border-radius: 16rpx;
  background: #f7fcf8;
  font-size: 26rpx;
  line-height: 1.48;
  color: #1a241f;
}

.top-actions,
.chip-row {
  display: flex;
  margin-top: 12rpx;
}

.light-btn,
.solid-btn,
.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.light-btn {
  flex: 1;
  margin-right: 10rpx;
  border: 2rpx solid rgba(19, 183, 91, 0.2);
  background: #f7fbf7;
  color: #15a753;
}

.solid-btn {
  width: 200rpx;
  background: linear-gradient(180deg, #16c45f 0%, #10b155 100%);
  color: #ffffff;
}

.chip-row {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.info-chip {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #15c25d;
  color: #ffffff;
  font-size: 21rpx;
}

.info-chip-ghost {
  background: #edf8ef;
  color: #13a552;
}

.result-card {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  overflow: hidden;
}

.tab-row {
  display: flex;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #eaf5ed;
  margin: 16rpx 16rpx 0;
}

.tab-item {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #77877c;
}

.tab-item-active {
  background: #ffffff;
  color: #13ad54;
}

.content-card {
  padding: 14rpx 16rpx 12rpx;
}

.tab-panel {
  display: flex;
  flex-direction: column;
}

.preview-frame {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eff4ef;
}

.preview-media {
  width: 100%;
  height: 268rpx;
}

.image-fit {
  height: 268rpx;
}

.play-button {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 92rpx;
  height: 92rpx;
  margin-left: -46rpx;
  margin-top: -46rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
}

.play-button::after {
  content: "";
  position: absolute;
  left: 36rpx;
  top: 27rpx;
  width: 0;
  height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 28rpx solid #16b75a;
}

.source-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f5faf6;
}

.source-summary-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #405443;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-summary-action {
  margin-left: 12rpx;
  font-size: 23rpx;
  color: #14a854;
  font-weight: 600;
}

.selector-scroll {
  margin-top: 8rpx;
  white-space: nowrap;
}

.selector-track {
  display: inline-flex;
  padding-bottom: 6rpx;
}

.selector-chip {
  min-width: 144rpx;
  margin-right: 10rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #e5efe7;
  border-radius: 999rpx;
  background: #fbfffb;
  font-size: 23rpx;
  text-align: center;
  color: #506252;
}

.selector-chip-active {
  border-color: #15be5b;
  background: #eefaf1;
  color: #14a854;
}

.title-panel {
  justify-content: flex-start;
}

.clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.bottom-bar {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  padding: 0 16rpx 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.progress-card {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #f4faf5;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-label,
.progress-value,
.progress-text {
  font-size: 22rpx;
  color: #4f6454;
}

.progress-track {
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: rgba(19, 183, 91, 0.12);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #14c15c 0%, #73dd8f 100%);
}

.progress-text {
  margin-top: 10rpx;
}

.primary-btn {
  width: 100%;
  background: linear-gradient(180deg, #16c45f 0%, #10b155 100%);
  color: #ffffff;
}
