<view wx:if="{{detailResult}}" class="page">

  <!-- 信息栏 -->
  <view class="info-bar">
    <view class="info-main">
      <view class="info-title clamp-1">{{detailResult.title || '未命名作品'}}</view>
      <view class="info-meta">@{{detailResult.author.nickname || '匿名'}} · {{statisticsText || '暂无热度'}}</view>
    </view>
    <view class="media-badge">{{detailResult.mediaType === 'video' ? '视频' : '图文'}}</view>
  </view>

  <!-- 预览区 -->
  <view class="preview-wrap" bindtap="onPreviewPrimaryMedia">
    <image
      class="preview-img"
      mode="aspectFill"
      src="{{resultTab === 'image' ? (selectedImagePreview || detailResult.cover) : detailResult.cover}}"
    />
    <view wx:if="{{resultTab === 'video'}}" class="play-btn"></view>
    <view class="preview-tags">
      <view wx:if="{{resultTab === 'video' && selectedSourceQuality}}" class="tag">{{selectedSourceQuality}}</view>
      <view wx:if="{{resultTab === 'video' && durationText}}" class="tag">{{durationText}}</view>
      <view wx:if="{{resultTab === 'image' && selectedImageIndexText}}" class="tag">{{selectedImageIndexText}}</view>
    </view>
  </view>

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view class="tab {{resultTab === 'video' ? 'tab-on' : ''}}" data-tab="video" bindtap="onResultTabTap">视频</view>
    <view class="tab {{resultTab === 'image' ? 'tab-on' : ''}}" data-tab="image" bindtap="onResultTabTap">图片</view>
    <view class="tab {{resultTab === 'title' ? 'tab-on' : ''}}" data-tab="title" bindtap="onResultTabTap">信息</view>
  </view>

  <!-- 内容区：源列表 / 图片列表 / 信息 -->
  <view class="panel">
    <scroll-view wx:if="{{resultTab === 'video'}}" class="chip-scroll" scroll-x="true" enable-flex="true">
      <view class="chip-track">
        <view
          wx:for="{{detailResult.sources}}"
          wx:key="id"
          class="chip {{selectedSourceId === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectSource"
        >{{item.displayLabel}}</view>
      </view>
    </scroll-view>

    <scroll-view wx:if="{{resultTab === 'image'}}" class="chip-scroll" scroll-x="true" enable-flex="true">
      <view class="chip-track">
        <view
          wx:for="{{detailResult.images}}"
          wx:key="id"
          class="chip {{selectedImageId === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          data-url="{{item.downloadUrl || item.url}}"
          bindtap="onSelectImage"
        >第{{index + 1}}张</view>
      </view>
    </scroll-view>

    <view wx:if="{{resultTab === 'title'}}" class="info-grid">
      <view class="ig-row">
        <view class="ig-label">标题</view>
        <view class="ig-value clamp-2">{{detailResult.title || '未命名作品'}}</view>
      </view>
      <view class="ig-row">
        <view class="ig-label">作者</view>
        <view class="ig-value">{{detailResult.author.nickname || '匿名作者'}}</view>
      </view>
      <view class="ig-row">
        <view class="ig-label">热度</view>
        <view class="ig-value">{{statisticsText || '暂无数据'}}</view>
      </view>
      <view class="ig-row">
        <view class="ig-label">资源</view>
        <view class="ig-value">
          {{detailResult.mediaType === 'video' ? ('视频源 ' + detailResult.sources.length + ' 个') : ('图片 ' + detailResult.images.length + ' 张')}}
        </view>
      </view>
    </view>
  </view>

  <!-- 下载进度 -->
  <view wx:if="{{downloadProgressVisible}}" class="progress-wrap">
    <view class="progress-track">
      <view class="progress-fill" style="width: {{downloadProgress}}%;"></view>
    </view>
    <view class="progress-text">{{downloadProgressText}}</view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="btn-reextract" bindtap="onReExtractTap">
      {{loading ? '' : '重提取'}}
    </view>
    <button class="btn-save" loading="{{loading}}" disabled="{{loading}}" bindtap="onSaveTap">
      {{loading ? loadingText : (detailResult.mediaType === 'video' ? '保存视频到相册' : '保存图片到相册')}}
    </button>
  </view>
</view>
