.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #111827;
}

/* ── 信息栏 ── */
.info-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 16rpx;
  background: #111827;
}

.info-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f9fafb;
  line-height: 1.2;
}

.info-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(249, 250, 251, 0.48);
}

.media-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: rgba(249, 250, 251, 0.8);
}

/* ── 预览区 ── */
.preview-wrap {
  position: relative;
  height: 320rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #0f172a;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.play-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  margin-top: -48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}

.play-btn::after {
  content: "";
  position: absolute;
  left: 38rpx;
  top: 28rpx;
  width: 0;
  height: 0;
  border-top: 20rpx solid transparent;
  border-bottom: 20rpx solid transparent;
  border-left: 30rpx solid #111827;
}

.preview-tags {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.54);
  font-size: 21rpx;
  color: #ffffff;
}

/* ── Tab 栏 ── */
.tab-bar {
  display: flex;
  background: #1f2937;
  padding: 0 20rpx;
}

.tab {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(249, 250, 251, 0.44);
  position: relative;
}

.tab-on {
  color: #f9fafb;
}

.tab-on::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  border-radius: 999rpx;
  background: #f9fafb;
}

/* ── 内容面板 ── */
.panel {
  background: #1f2937;
  padding: 16rpx 20rpx 12rpx;
  min-height: 100rpx;
}

.chip-scroll {
  white-space: nowrap;
  height: 74rpx;
}

.chip-track {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 100%;
}

.chip {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
  color: rgba(249, 250, 251, 0.7);
  background: rgba(255, 255, 255, 0.06);
}

.chip-on {
  border-color: #f9fafb;
  background: rgba(255, 255, 255, 0.14);
  color: #f9fafb;
}

/* ── 信息网格 ── */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.ig-row {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
}

.ig-label {
  font-size: 20rpx;
  color: rgba(249, 250, 251, 0.4);
}

.ig-value {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #f9fafb;
  word-break: break-all;
}

/* ── 进度条 ── */
.progress-wrap {
  padding: 10rpx 20rpx 0;
  background: #1f2937;
}

.progress-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #f9fafb;
  transition: width 0.2s;
}

.progress-text {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(249, 250, 251, 0.5);
}

/* ── 底部操作栏 ── */
.action-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx 32rpx;
  background: #111827;
}

.btn-reextract {
  flex-shrink: 0;
  width: 136rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(249, 250, 251, 0.8);
}

.btn-reextract:active {
  background: rgba(255, 255, 255, 0.06);
}

.btn-save {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f9fafb;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.btn-save:active {
  background: #e5e7eb;
}

.btn-save[disabled] {
  opacity: 0.4;
}

/* ── 工具类 ── */
.clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
